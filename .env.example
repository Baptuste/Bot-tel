# Copie ce fichier en ".env" et renseigne le token de TON bot de test (BotFather).
# Le fichier .env est ignore par git (voir .gitignore) - ne jamais le commiter.
BOT_TOKEN=123456789:AA-remplace-par-ton-token-de-test

# user_id Telegram autorises aux commandes admin + a la Mini App (virgules).
# Pour connaitre ton id : commande /id du bot, ou @userinfobot.
ADMIN_IDS=

# Serveur HTTP (API + Mini App admin).
PORT=3000
# URL publique HTTPS de la Mini App (tunnel cloudflared en dev).
# Laisser vide tant que le tunnel n'est pas lance.
WEBAPP_URL=

# Config metier active (src/features.ts). Defaut : pizzeria.
# Autre valeur livree : boutique-demo (retrait boutique, sans tournees).
CLIENT_ID=pizzeria
# Chemin de la base SQLite (relatif au dossier du projet). Defaut : data/bot.db.
# DB_PATH=data/bot.db
