# Dependances
node_modules/
web/node_modules/

# Build
dist/
web/dist/

# Secrets - JAMAIS commite
.env

# Base de donnees SQLite (locale)
data/*.db
data/*.db-shm
data/*.db-wal
!data/.gitkeep

# Images produits uploadees
data/uploads/

# Logs
*.log
npm-debug.log*

# Sauvegarde d'un .git corrompu (2026-08-31) - a supprimer via l'Explorateur Windows
.git-broken/

# Reglages Claude Code personnels (permissions locales)
.claude/settings.local.json

# Graphify - graphe de code : seuls graph.json + GRAPH_REPORT.md sont versionnes
# (le reste est regenerable / local : viz, cache AST, cost.json, metadonnees).
graphify-out/*
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md
.graphify_analysis.json
.graphify_labels.json
